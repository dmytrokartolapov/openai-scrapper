{
  "openapi": "3.1.0",
  "info": {
    "title": "FastAPI",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Health status",
        "description": "Basic health status.",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthStatus"
                }
              }
            }
          }
        }
      }
    },
    "/v1/db/scrape_url": {
      "get": {
        "tags": [
          "scrape_url"
        ],
        "summary": "Will scraped data to database.",
        "operationId": "db_scrape_url_v1_db_scrape_url_get",
        "parameters": [
          {
            "name": "url",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "",
              "title": "Url"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScrapResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/db/semantic_search": {
      "get": {
        "tags": [
          "semantic_search"
        ],
        "summary": "Runs semantic search in database.",
        "operationId": "db_semantic_search_v1_db_semantic_search_get",
        "parameters": [
          {
            "name": "text",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "",
              "title": "Text"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "string"
                }
              ],
              "default": 5,
              "title": "Limit"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthStatus": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          }
        },
        "type": "object",
        "required": [
          "status"
        ],
        "title": "HealthStatus",
        "description": "Model for health check."
      },
      "ScrapResponse": {
        "properties": {
          "url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Url",
            "description": "The URL from which data were be scraped.",
            "examples": [
              "https://example.com"
            ]
          },
          "messages": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Messages",
            "description": "Messages scraped from url and summary from LangChain.",
            "default": [],
            "examples": [
              [
                "message_1",
                "message_2",
                "message_3"
              ]
            ]
          },
          "job": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Job",
            "description": "The job that was done.",
            "examples": [
              "saved_to_db",
              "read_from_db"
            ]
          }
        },
        "type": "object",
        "title": "ScrapResponse",
        "description": "Model for a response with scraped data from a given URL."
      },
      "SearchResponse": {
        "properties": {
          "text": {
            "type": "string",
            "title": "Text",
            "description": "The query to semantic search for.",
            "default": "",
            "examples": [
              "Chinese cuisine in the UK"
            ]
          },
          "payload": {
            "items": {},
            "type": "array",
            "title": "Payload",
            "description": "Result of semantic search",
            "default": [],
            "examples": [
              [
                "Headline: *** \n Summary: *** \n Keywords: ***"
              ]
            ]
          },
          "job": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Job",
            "description": "The job that was done.",
            "examples": [
              "saved_to_db",
              "read_from_db"
            ]
          }
        },
        "type": "object",
        "title": "SearchResponse",
        "description": "Model for a response with scraped data from a given URL."
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}